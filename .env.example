# ── 기존 리뷰온도 설정 ─────────────────────────────────────
SECRET_KEY=your-secret-key
CAFE24_CLIENT_ID=your-client-id
CAFE24_CLIENT_SECRET=your-client-secret

# ── 자동매매 기본 설정 ────────────────────────────────────────
INITIAL_CAPITAL=100          # 초기 자본금 (단위 자유)
MAX_POSITION_SIZE=0.20       # 종목당 최대 비중 (20%)
STOP_LOSS_PCT=0.05           # 손절 기준 (-5%)
TAKE_PROFIT_PCT=0.15         # 익절 기준 (+15%)
BUY_THRESHOLD=0.35           # 이 점수 이상이면 BUY
SELL_THRESHOLD=-0.35         # 이 점수 이하면 SELL

# ── 감시 종목 (쉼표 구분) ────────────────────────────────────
WATCHLIST_US=AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,JPM,NFLX,AMD
WATCHLIST_KR=005930,000660,035420,005380,051910,035720,000270,068270
# 삼성전자, SK하이닉스, 네이버, 현대차, LG화학, 카카오, 기아, 셀트리온

# ── 선택: 있으면 신호 정확도 올라감 ────────────────────────────
# DART_API_KEY=         # 금융감독원 전자공시 (한국 내부자 거래)
#                       # https://opendart.fss.or.kr 에서 무료 발급
# NEWS_API_KEY=         # NewsAPI (https://newsapi.org 무료 100회/일)

TRADING_DB_PATH=trading.db
